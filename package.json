{
  "name": "react-hextime",
  "version": "0.1.13",
  "author": {
    "name": "GNLC",
    "url": "https://github.com/iamgnlc"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run generate-meta-tag && tsc --noEmit && vite build",
    "ci": "sh ci.sh",
    "clean": "rm -rf dist",
    "deploy": "firebase deploy",
    "dev": "vite --port 3032",
    "generate-meta-tag": "node ./scripts/generate-meta-tag.mjs",
    "predeploy": "npm run clean && npm version --no-git-tag-version patch && npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fvilers/disable-react-devtools": "^1.2.1",
    "@sentry/react": "^11.0.0",
    "react": "^19.3.0",
    "react-cache-buster": "^0.1.8",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^30.1.1",
    "sass": "^1.105.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true
  }
}
